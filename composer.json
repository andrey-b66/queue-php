{
    "name": "integrat/queue",
    "description": "Автономный движок очереди на SQLite: приём заданий, файловые хуки, фоновый воркер и встроенная веб-админка.",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Integrat\\Queue\\": "src/"
        }
    },
    "bin": [
        "bin/integrat-queue"
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "cs-check": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --dry-run --diff --rules=@PSR12 --using-cache=no ."
        ],
        "cs-fix": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --rules=@PSR12 --using-cache=no ."
        ],
        "test": [
            "@php tests/InstallCommandTest.php",
            "@php tests/QueueIntegrationTest.php"
        ]
    }
}
