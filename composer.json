{
    "name": "integrat/queue",
    "description": "Очередь задач на SQLite: приём заданий, хранение, разбор и встроенная веб-админка.",
    "license": "proprietary",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Integrat\\Queue\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Integrat\\Queue\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff --rules=@PSR12 --using-cache=no .",
        "cs-fix": "php-cs-fixer fix --rules=@PSR12 --using-cache=no .",
        "test": "phpunit"
    }
}
