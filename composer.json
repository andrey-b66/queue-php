{
    "name": "integrat/queue",
    "description": "Автономный движок очереди на SQLite: приём заданий, файловые хуки, фоновый воркер и встроенная веб-админка.",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Integrat\\Queue\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "cs-check": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --dry-run --diff --rules=@PSR12 --using-cache=no ."
        ],
        "cs-fix": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --rules=@PSR12 --using-cache=no ."
        ],
        "test": "@php tests/EntrypointsTest.php"
    }
}
